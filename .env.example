# Core database connection
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"
# Auth.js / NextAuth
AUTH_SECRET="replace-with-a-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# AI provider settings used by /api/ai/* routes
ABACUSAI_API_KEY=""
ABACUSAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/chat/completions"
ABACUSAI_MODEL="models/gemini-3.8-flash"
ABACUSAI_FALLBACK_MODEL="models/gemini-3.5-flash"

# Optional build/runtime settings
NEXT_DIST_DIR=".next"
NEXT_OUTPUT_MODE=""

# Neon Object Storage settings
AWS_BUCKET_NAME="assets"
AWS_FOLDER_PREFIX=""

# Required for snapshot capture and review. Generate a stable key with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SNAPSHOT_ENCRYPTION_KEY="replace-with-a-long-random-secret"

# Required for the scheduled daily snapshot-retention cleanup on Vercel
CRON_SECRET="replace-with-a-long-random-secret"
