# Copy this file to .env.local and replace the placeholder values with real local secrets.
# Do not commit .env.local containing real credentials.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@localhost:5432/nextjs_local_db?schema=public"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nextjs_local_db?schema=public"
AUTH_SECRET="replace-with-a-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Required for the optional AI routes under /api/ai/*
ABACUSAI_API_KEY=your-abacus-api-key
ABACUSAI_BASE_URL="https://apps.abacus.ai/v1/chat/completions"
ABACUSAI_MODEL="gpt-5.4-mini"

# Optional runtime settings
NEXT_DIST_DIR=".next"
NEXT_OUTPUT_MODE=""

# Neon Object Storage settings
AWS_BUCKET_NAME="assets"
AWS_FOLDER_PREFIX=""
# Required for snapshot capture and review. Generate a stable key with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SNAPSHOT_ENCRYPTION_KEY="replace-with-a-long-random-secret"

# Required for the scheduled daily snapshot-retention cleanup on Vercel
CRON_SECRET="replace-with-a-long-random-secret"
